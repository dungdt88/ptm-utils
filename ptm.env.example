# ptmutils configuration. Copy to `ptm.env` here, or to ~/.config/ptm/ptm.env
# for a machine-wide setting. Everything here is optional, and every line is
# commented out on purpose — uncomment only what you want to override.

# Where the context registry lives (one entry per Obsidian vault).
# Manage it with `ptmutils context add|remove|default` rather than by hand.
#PTM_CONTEXTS_FILE=~/.config/ptm/contexts.yaml

# Context used when a command runs without --context. Prefer setting this with
# `ptmutils context default <slug>`, which validates that the slug exists.
#PTM_DEFAULT_CONTEXT=nf

# Folder inside each vault that holds the monthly pages.
#PTM_NOTES_DIR=notes
